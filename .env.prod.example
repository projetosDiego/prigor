# ============================================================================
#  Doces Prigor OS — variáveis de PRODUÇÃO (VPS)
#
#  1) Na VPS:  cp .env.prod.example .env && nano .env
#  2) Preencha os valores reais.
#  3) Nunca commite o .env (já está no .gitignore).
#
#  Este arquivo é lido pelo docker-compose.prod.yml.
# ============================================================================

# ─── Domínio ────────────────────────────────────────────────────────────────
# Sem http://, sem barra. O www é adicionado automaticamente pelo compose.
APP_DOMAIN=docesprigor.com.br

# E-mail de notificação dos certificados Let's Encrypt.
LETSENCRYPT_EMAIL=

# ─── Banco ──────────────────────────────────────────────────────────────────
# O Prigor usa o Postgres que já roda para o ActPost, com banco e usuário
# próprios. Crie os dois uma única vez — ver docs/DEPLOY.md, passo 3.
PRIGOR_DB_NAME=prigor
PRIGOR_DB_USER=prigor
# Gere com:  openssl rand -base64 32
PRIGOR_DB_PASSWORD=

# ─── Sessão ─────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com:  openssl rand -hex 32
# Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=
SESSION_TTL_HOURS=12

# ─── Aplicação ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10

# ─── Google Places ──────────────────────────────────────────────────────────
# Obrigatória em produção: sem chave válida a aplicação se recusa a subir,
# para não haver prospecção rodando em modo simulado sem ninguém perceber.
GOOGLE_MAPS_API_KEY=

# ─── Administrador inicial ──────────────────────────────────────────────────
# Deixe RUN_SEED=true APENAS na primeira subida. Depois volte para false e
# apague a senha daqui.
RUN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ─── Dados da empresa (aparecem no PDF do pedido) ───────────────────────────
COMPANY_NAME=Doces Prigor
COMPANY_LEGAL_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=Rio de Janeiro
COMPANY_STATE=RJ
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=
