# ============================================================================
#  Doces Prigor OS — variáveis de PRODUÇÃO (VPS)
#
#  1) Na VPS:  cp .env.prod.example .env && nano .env
#  2) Preencha os valores reais.
#  3) Nunca commite o .env (já está no .gitignore).
#
#  Este arquivo é lido pelo docker-compose.prod.yml.
# ============================================================================

# ─── Domínio ────────────────────────────────────────────────────────────────
# Sem http://, sem barra. O www é adicionado automaticamente pelo compose.
# Com o site oficial no ar, o sistema passa para app.<domínio> — quem faz essa
# troca (e grava as variáveis SITE_* abaixo) é scripts/publicar-site.sh.
APP_DOMAIN=docesprigor.com.br

# E-mail de notificação dos certificados Let's Encrypt.
LETSENCRYPT_EMAIL=

# ─── Banco ──────────────────────────────────────────────────────────────────
# O Prigor usa o Postgres que já roda para o ActPost, com banco e usuário
# próprios. Crie os dois uma única vez — ver docs/DEPLOY.md, passo 3.
PRIGOR_DB_NAME=prigor
PRIGOR_DB_USER=prigor
# Gere com:  openssl rand -base64 32
PRIGOR_DB_PASSWORD=

# ─── Sessão ─────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com:  openssl rand -hex 32
# Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=
SESSION_TTL_HOURS=12

# ─── Aplicação ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10

# ─── Google Places ──────────────────────────────────────────────────────────
# Opcional. Sem ela o ERP funciona inteiro; só a prospecção de leads fica
# indisponível. O que NÃO se pode em produção é ligar ALLOW_MOCK_PLACES —
# isso gravaria estabelecimentos inventados no banco real, e a aplicação
# se recusa a subir nesse caso.
GOOGLE_MAPS_API_KEY=

# ─── Administrador inicial ──────────────────────────────────────────────────
# Deixe RUN_SEED=true APENAS na primeira subida. Depois volte para false e
# apague a senha daqui.
RUN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ─── Dados da empresa (aparecem no PDF do pedido) ───────────────────────────
COMPANY_NAME=Doces Prigor
COMPANY_LEGAL_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=Rio de Janeiro
COMPANY_STATE=RJ
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=

# ─── Nota fiscal (Notaas) ───────────────────────────────────────────────────
# Preencha com:  bash scripts/configurar-nf.sh
FISCAL_PROVIDER=
FISCAL_API_TOKEN=
FISCAL_ENV=homologacao

# ─── Boleto (Sicoob) — deixe desligado até o teste real ─────────────────────
BILLING_ENABLED=false

# ─── Cobrança automática (cron da VPS chama /api/public/cron/cobranca) ─────
# Gere com: openssl rand -hex 24  (mínimo 16 caracteres; vazio = rotina desligada)
CRON_SECRET=""

# ─── Pedidos do site oficial (docesprigor.com.br/natal2026) ─────────────────
# Mesmo valor do campo "Segredo compartilhado" em Configurações → ERP no painel
# do site. Gere com: openssl rand -hex 32  (mínimo 32; vazio = integração desligada)
SITE_ORDERS_SECRET=""

# ─── Site oficial (pasta site/) ─────────────────────────────────────────────
# Não preencha à mão: rode  bash scripts/publicar-site.sh  na VPS.
#   APP_HOSTS            host(s) do sistema quando ele mora em subdomínio
#   SITE_DOMAIN          domínio do site (docesprigor.com.br)
#   SITE_ADMIN_EMAIL     login do painel do site (/admin)
#   SITE_ADMIN_PASSWORD  senha do painel do site (12+ caracteres)
#   SITE_SESSION_SECRET  segredo das sessões do painel do site
