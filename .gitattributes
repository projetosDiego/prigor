# Normaliza fim de linha: no repositório tudo vira LF, e o checkout também
# entrega LF (inclusive no Windows). Sem isso, o editor grava CRLF e o git
# marca 100% dos arquivos como modificados; além disso, script .sh com CRLF
# quebra no VPS Linux (Docker/deploy).
* text=auto eol=lf

# Scripts de shell PRECISAM ser LF para rodar no Linux.
*.sh    text eol=lf

# Binários: nunca converter.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
