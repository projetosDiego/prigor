# Banco (SQLite local). Para PostgreSQL, troque o provider em prisma/schema.prisma.
DATABASE_URL="file:../data/prigor.db"

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.docesprigor.com.br"

# Acesso ao painel /admin
ADMIN_EMAIL="voce@docesprigor.com.br"
# Mínimo 12 caracteres
ADMIN_PASSWORD=""
# Segredo das sessões do painel — gere com: openssl rand -hex 32
SESSION_SECRET=""

# Onde ficam as imagens enviadas pelo painel
UPLOAD_DIR="./data/uploads"
