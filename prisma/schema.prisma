// ============================================================================
//  Doces Prigor OS — schema único do banco
//
//  Este arquivo é a ÚNICA fonte de verdade do banco. Não existe mais um
//  segundo conjunto de modelos em Python: o backend FastAPI foi aposentado e
//  todo o acesso a dados passa por aqui.
//
//  Convenções:
//   * Campos em camelCase no código, colunas em snake_case no banco (@map).
//   * Dinheiro é Decimal(12,2) — nunca Float. Float acumula erro de
//     arredondamento e este é um sistema financeiro.
//   * Quantidades são Decimal(12,3) pelo mesmo motivo.
//   * Percentuais são Decimal(5,2).
// ============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SELLER
}

enum PipelineStage {
  NOVO
  QUALIFICADO
  ATRIBUIDO
  ABORDADO
  CONTATO_REALIZADO
  INTERESSADO
  REUNIAO
  AMOSTRA
  NEGOCIACAO
  NOVO_REVENDEDOR
  PERDIDO
}

enum LossReason {
  SEM_INTERESSE
  PRECO
  JA_POSSUI_FORNECEDOR
  PRODUZ_INTERNAMENTE
  NAO_TRABALHA_COM_SOBREMESAS
  BAIXO_MOVIMENTO
  ESTABELECIMENTO_FECHADO
  CONTATO_INVALIDO
  RESPONSAVEL_NAO_ENCONTRADO
  OUTRO
}

enum ActivityType {
  VISIT
  WHATSAPP
  PHONE
  MEETING
  SAMPLE
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
}

enum MeetingStatus {
  AGENDADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum SampleResult {
  GOSTOU
  INTERESSADO
  PENSANDO
  NAO_GOSTOU
  SEM_INTERESSE
}

enum ProductType {
  venda
  insumo
}

enum StockMovementType {
  baixa_insumo
  entrada_recheio
  entrada_produto
  saida_venda
}

enum TransactionType {
  receita
  despesa
}

enum TransactionStatus {
  pendente
  pago
  atrasado
  cancelado
}

enum OrderStatus {
  novo
  confirmado
  em_producao
  entregue
  faturado
  cancelado
}

enum PaymentMethod {
  dinheiro
  pix
  debito
  credito
  boleto
  transferencia
}

enum ProspectingRunStatus {
  RUNNING
  SUCCESS
  SUCCESS_SIMULADO
  FAILED
}

// ─── Acesso ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @map("nome")
  email        String   @unique
  phone        String?  @map("telefone")
  passwordHash String   @map("senha_hash")
  role         Role     @default(SELLER)
  active       Boolean  @default(true) @map("ativo")
  createdAt    DateTime @default(now()) @map("criado_em")
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  seller    Seller?
  auditLogs AuditLog[]

  @@index([active])
  @@map("usuarios")
}

model Seller {
  id            String   @id @default(uuid())
  userId        String   @unique @map("usuario_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @map("nome")
  phone         String?  @map("telefone")
  email         String?  @map("email")
  active        Boolean  @default(true) @map("ativo")
  goal          Int      @default(0) @map("meta")
  commissionPct Decimal  @default(0) @map("comissao_pct") @db.Decimal(5, 2)
  notes         String?  @map("observacoes")
  createdAt     DateTime @default(now()) @map("criado_em")
  updatedAt     DateTime @updatedAt @map("atualizado_em")

  neighborhoods Neighborhood[]
  leads         Lead[]
  customers     Customer[]
  activities    Activity[]
  meetings      Meeting[]
  samples       Sample[]
  orders        Order[]

  @@index([active])
  @@map("vendedores")
}

// ─── Território ─────────────────────────────────────────────────────────────

model Region {
  id          String   @id @default(uuid())
  name        String   @unique @map("nome")
  description String?  @map("descricao")
  active      Boolean  @default(true) @map("ativo")
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  neighborhoods Neighborhood[]
  leads         Lead[]
  customers     Customer[]

  @@map("regioes")
}

model Neighborhood {
  id        String   @id @default(uuid())
  name      String   @map("nome")
  city      String   @default("Rio de Janeiro") @map("cidade")
  state     String   @default("RJ") @map("uf")
  regionId  String   @map("regiao_id")
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  sellerId  String?  @map("vendedor_id")
  seller    Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  active    Boolean  @default(true) @map("ativo")
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  leads     Lead[]
  customers Customer[]

  @@unique([name, city, state])
  @@index([regionId])
  @@index([sellerId])
  @@map("bairros")
}

// ─── Clientes e leads ───────────────────────────────────────────────────────

model Customer {
  id         String  @id @default(uuid())
  tradeName  String  @map("apelido")
  legalName  String? @map("nome")
  cnpj       String? @unique @map("cnpj")
  cpf        String? @map("cpf")
  phone      String? @map("telefone")
  mobile     String? @map("celular")
  email      String? @map("email")
  address    String? @map("endereco")
  number     String? @map("numero")
  complement String? @map("complemento")

  neighborhood String? @map("bairro")
  city         String? @map("cidade")
  state        String? @map("uf")
  zipCode      String? @map("cep")
  latitude     Float?  @map("latitude")
  longitude    Float?  @map("longitude")
  category     String? @map("categoria")

  sellerId        String?       @map("vendedor_id")
  seller          Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId        String?       @map("regiao_id")
  region          Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  neighborhoodId  String?       @map("bairro_id")
  neighborhoodRel Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  status        String  @default("ATIVO") @map("status")
  notes         String? @map("observacoes")
  googlePlaceId String? @unique @map("google_place_id")

  externalCode String?   @map("codigo_externo")
  listType     String?   @map("tipo_lista")
  document     String?   @map("documento")
  rg           String?   @map("rg")
  ufRg         String?   @map("uf_rg")
  ie           String?   @map("ie")
  ieIndicator  String?   @map("ie_indicador")
  website      String?   @map("site")
  birthDate    DateTime? @map("data_nascimento") @db.Date
  isReseller   Boolean   @default(false) @map("is_revendedor")
  active       Boolean   @default(true) @map("ativo")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  leadsConverted Lead[]     @relation("ConvertedCustomer")
  activities     Activity[]
  orders         Order[]

  @@index([sellerId])
  @@index([active])
  @@index([status])
  @@index([tradeName])
  @@map("clientes")
}

model Lead {
  id             String  @id @default(uuid())
  tradeName      String  @map("nome_fantasia")
  legalName      String? @map("razao_social")
  cnpj           String? @unique
  phone          String?
  mobile         String?
  email          String?
  address        String
  number         String?
  complement     String?
  neighborhood   String
  city           String
  state          String
  zipCode        String?
  latitude       Float
  longitude      Float
  category       String
  googlePlaceId  String? @unique @map("google_place_id")
  score          Int     @default(0)
  scoreBreakdown Json?   @map("score_detalhes")

  sellerId        String?       @map("vendedor_id")
  seller          Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId        String?       @map("regiao_id")
  region          Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  neighborhoodId  String?       @map("bairro_id")
  neighborhoodRel Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  pipelineStage PipelineStage @default(NOVO) @map("etapa_funil")
  source        String        @default("AUTOMATIC") @map("origem")
  priority      String        @default("MEDIA") @map("prioridade")
  status        String        @default("ATIVO")
  lossReason    LossReason?   @map("motivo_perda")
  lossNotes     String?       @map("observacoes_perda")
  simulated     Boolean       @default(false) @map("simulado")

  firstContactAt      DateTime? @map("primeiro_contato_em")
  convertedCustomerId String?   @map("cliente_convertido_id")
  convertedCustomer   Customer? @relation("ConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  activities Activity[]
  meetings   Meeting[]
  samples    Sample[]

  @@index([sellerId])
  @@index([pipelineStage])
  @@index([status])
  @@index([score])
  @@index([neighborhoodId])
  @@map("leads")
}

model Activity {
  id          String       @id @default(uuid())
  leadId      String?      @map("lead_id")
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId  String?      @map("cliente_id")
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId    String?      @map("vendedor_id")
  seller      Seller?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  type        ActivityType @map("tipo")
  description String       @map("descricao")
  date        DateTime     @default(now()) @map("data_atividade")
  latitude    Float?
  longitude   Float?
  result      String?      @map("resultado")
  createdAt   DateTime     @default(now()) @map("criado_em")

  @@index([leadId])
  @@index([customerId])
  @@index([sellerId, date])
  @@map("atividades")
}

model Meeting {
  id          String        @id @default(uuid())
  leadId      String        @map("lead_id")
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerId    String        @map("vendedor_id")
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  date        DateTime      @map("data_reuniao")
  location    String?       @map("local")
  observation String?       @map("observacao")
  status      MeetingStatus @default(AGENDADA)
  createdAt   DateTime      @default(now()) @map("criado_em")
  updatedAt   DateTime      @updatedAt @map("atualizado_em")

  @@index([leadId])
  @@index([sellerId, date])
  @@map("reunioes")
}

model Sample {
  id          String        @id @default(uuid())
  leadId      String        @map("lead_id")
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerId    String        @map("vendedor_id")
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  date        DateTime      @default(now()) @map("data_entrega")
  product     String        @default("Brownie Recheado 7x5") @map("produto")
  quantity    Int           @default(1) @map("quantidade")
  flavors     String?       @map("sabores")
  observation String?       @map("observacao")
  result      SampleResult? @map("resultado")
  createdAt   DateTime      @default(now()) @map("criado_em")
  updatedAt   DateTime      @updatedAt @map("atualizado_em")

  @@index([leadId])
  @@index([sellerId])
  @@map("amostras")
}

// ─── Catálogo, estoque e receita ────────────────────────────────────────────

model Product {
  id               String      @id @default(uuid())
  sku              String?     @unique @map("sku")
  barCode          String?     @map("codigo_barras")
  internalCode     String?     @map("codigo_interno")
  name             String      @map("nome")
  storeName        String?     @map("nome_loja")
  description      String?     @map("descricao")
  storeDescription String?     @map("descricao_loja")
  category         String?     @map("categoria")
  subcategory      String?     @map("subcategoria")
  brand            String?     @map("marca")
  model            String?     @map("modelo")
  type             ProductType @default(venda) @map("tipo")
  unit             String      @default("un") @map("unidade")

  salePrice       Decimal @default(0) @map("preco_venda") @db.Decimal(12, 2)
  wholesalePrice  Decimal @default(0) @map("preco_atacado") @db.Decimal(12, 2)
  minWholesaleQty Decimal @default(0) @map("qtd_min_atacado") @db.Decimal(12, 3)
  priceFrom       Decimal @default(0) @map("preco_de") @db.Decimal(12, 2)
  priceTo         Decimal @default(0) @map("preco_por") @db.Decimal(12, 2)
  cost            Decimal @default(0) @map("custo") @db.Decimal(12, 2)

  stock      Decimal @default(0) @map("estoque") @db.Decimal(12, 3)
  minStock   Decimal @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  trackStock Boolean @default(true) @map("movimenta_estoque")

  ncm    String? @map("ncm")
  cfop   String? @map("cfop")
  origin String? @map("origem")
  cest   String? @map("cest")

  weightKg Decimal @default(0) @map("peso_kg") @db.Decimal(12, 3)
  heightCm Decimal @default(0) @map("altura_cm") @db.Decimal(12, 2)
  widthCm  Decimal @default(0) @map("largura_cm") @db.Decimal(12, 2)
  depthCm  Decimal @default(0) @map("profundidade_cm") @db.Decimal(12, 2)

  tags           String?  @map("tags")
  warranty       String?  @map("garantia")
  includedItems  String?  @map("itens_inclusos")
  specifications String?  @map("especificacoes")
  image          String?  @map("imagem")
  commissionPct  Decimal? @map("comissao_pct") @db.Decimal(5, 2)
  active         Boolean  @default(true) @map("ativo")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  ingredients    RecipeIngredient[] @relation("ProductFinal")
  usedInRecipes  RecipeIngredient[] @relation("Ingredient")
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([type, active])
  @@index([barCode])
  @@index([internalCode])
  @@index([name])
  @@map("produtos")
}

model RecipeIngredient {
  id             String  @id @default(uuid())
  productFinalId String  @map("produto_final_id")
  productFinal   Product @relation("ProductFinal", fields: [productFinalId], references: [id], onDelete: Cascade)
  ingredientId   String  @map("insumo_id")
  ingredient     Product @relation("Ingredient", fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity       Decimal @map("quantidade") @db.Decimal(12, 3)
  observation    String? @map("observacao")

  @@unique([productFinalId, ingredientId])
  @@index([ingredientId])
  @@map("receita_ingredientes")
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String            @map("produto_id")
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType @map("tipo")
  quantity    Decimal           @map("quantidade") @db.Decimal(12, 3)
  stockBefore Decimal           @map("estoque_antes") @db.Decimal(12, 3)
  stockAfter  Decimal           @map("estoque_depois") @db.Decimal(12, 3)
  orderId     String?           @map("pedido_id")
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  observation String?           @map("observacao")
  createdAt   DateTime          @default(now()) @map("criado_em")

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@map("movimentacoes_estoque")
}

// ─── Pedidos ────────────────────────────────────────────────────────────────

model Order {
  id     String @id @default(uuid())
  numero Int    @unique @default(dbgenerated("nextval('pedidos_numero_seq')")) @map("numero")

  customerId String   @map("cliente_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  sellerId   String?  @map("vendedor_id")
  seller     Seller?  @relation(fields: [sellerId], references: [id])

  status        OrderStatus   @default(novo) @map("status")
  paymentMethod PaymentMethod @default(pix) @map("forma_pagamento")

  orderDate    DateTime  @map("data_pedido") @db.Date
  deliveryDate DateTime? @map("data_entrega") @db.Date
  billingDate  DateTime? @map("data_faturamento") @db.Date
  dueDate      DateTime? @map("data_vencimento") @db.Date

  discount      Decimal @default(0) @map("desconto") @db.Decimal(12, 2)
  shipping      Decimal @default(0) @map("frete") @db.Decimal(12, 2)
  otherCosts    Decimal @default(0) @map("outros_custos") @db.Decimal(12, 2)
  subtotal      Decimal @default(0) @map("subtotal") @db.Decimal(12, 2)
  total         Decimal @default(0) @map("total") @db.Decimal(12, 2)
  commissionVal Decimal @default(0) @map("comissao_valor") @db.Decimal(12, 2)

  notes String? @map("observacoes")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  items          OrderItem[]
  transactions   FinancialTransaction[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderDate])
  @@index([deliveryDate])
  @@map("pedidos")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("pedido_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String  @map("produto_id")
  product      Product @relation(fields: [productId], references: [id])
  quantity     Decimal @map("quantidade") @db.Decimal(12, 3)
  unitPrice    Decimal @map("preco_unitario") @db.Decimal(12, 2)
  discountItem Decimal @default(0) @map("desconto_item") @db.Decimal(12, 2)
  subtotal     Decimal @default(0) @map("subtotal") @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("pedido_itens")
}

// ─── Financeiro ─────────────────────────────────────────────────────────────

model FinancialTransaction {
  id          String          @id @default(uuid())
  type        TransactionType @map("tipo")
  description String          @map("descricao")
  category    String?         @map("categoria")
  value       Decimal         @map("valor") @db.Decimal(12, 2)

  issueDate   DateTime  @default(now()) @map("data_lancamento") @db.Date
  dueDate     DateTime? @map("data_vencimento") @db.Date
  paymentDate DateTime? @map("data_pagamento") @db.Date

  status  TransactionStatus @default(pendente) @map("status")
  orderId String?           @map("pedido_id")
  order   Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes   String?           @map("observacoes")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@index([type, status])
  @@index([dueDate])
  @@index([orderId])
  @@index([category])
  @@map("lancamentos")
}

// ─── Configuração e observabilidade ─────────────────────────────────────────

model ScoreSettings {
  id                  String   @id @default(uuid())
  categoryWeight      Int      @default(25) @map("peso_categoria")
  compatibilityWeight Int      @default(20) @map("peso_compatibilidade")
  commercialWeight    Int      @default(15) @map("peso_potencial")
  regionWeight        Int      @default(15) @map("peso_regiao")
  digitalWeight       Int      @default(10) @map("peso_digital")
  nearbyWeight        Int      @default(10) @map("peso_proximidade")
  dataQualityWeight   Int      @default(5) @map("peso_qualidade_dados")
  createdAt           DateTime @default(now()) @map("criado_em")
  updatedAt           DateTime @updatedAt @map("atualizado_em")

  @@map("score_config")
}

model ScoreHistory {
  id        String   @id @default(uuid())
  weights   Json     @map("pesos")
  updatedBy String   @map("atualizado_por")
  reason    String?  @map("motivo")
  createdAt DateTime @default(now()) @map("criado_em")

  @@map("score_historico")
}

model ProspectingRun {
  id             String               @id @default(uuid())
  startedAt      DateTime             @default(now()) @map("iniciado_em")
  finishedAt     DateTime?            @map("finalizado_em")
  regionId       String?              @map("regiao_id")
  neighborhoodId String?              @map("bairro_id")
  category       String?              @map("categoria")
  query          String?              @map("busca")
  resultsFound   Int                  @default(0) @map("resultados_encontrados")
  newLeads       Int                  @default(0) @map("novos_leads")
  duplicates     Int                  @default(0) @map("duplicados")
  existingCust   Int                  @default(0) @map("clientes_existentes")
  errors         String?              @map("erros")
  estimatedCost  Decimal              @default(0) @map("custo_estimado") @db.Decimal(10, 4)
  simulated      Boolean              @default(false) @map("simulado")
  status         ProspectingRunStatus @default(RUNNING)

  @@index([startedAt])
  @@map("prospeccao_execucao")
}

model ApiUsage {
  id            String   @id @default(uuid())
  date          DateTime @default(now()) @map("data_uso")
  service       String   @map("servico")
  endpoint      String   @map("endpoint")
  callCount     Int      @default(1) @map("quantidade_chamadas")
  estimatedCost Decimal  @default(0) @map("custo_estimado") @db.Decimal(10, 4)
  region        String?  @map("regiao")
  executionId   String?  @map("execucao_id")

  @@index([date])
  @@index([service])
  @@map("api_consumo")
}

model SystemSettings {
  id                 String   @id @default(uuid())
  dailyCostLimit     Decimal  @default(10) @map("limite_custo_diario") @db.Decimal(10, 2)
  monthlyCostLimit   Decimal  @default(150) @map("limite_custo_mensal") @db.Decimal(10, 2)
  currentDailyCost   Decimal  @default(0) @map("custo_diario_atual") @db.Decimal(10, 4)
  currentMonthlyCost Decimal  @default(0) @map("custo_mensal_atual") @db.Decimal(10, 4)
  costWindowDate     DateTime @default(now()) @map("janela_custo_data") @db.Date
  costWindowMonth    String   @default("") @map("janela_custo_mes")
  apiPaused          Boolean  @default(false) @map("api_pausada")
  nearbyRadiusKm     Int      @default(5) @map("raio_proximidade_km")
  whatsappTemplate   String   @default("Olá! Tudo bem? Sou {vendedor}, da Doces Prigor...") @map("template_whatsapp")
  updatedAt          DateTime @updatedAt @map("atualizado_em")

  @@map("config_sistema")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("usuario_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @map("acao")
  entity    String   @map("entidade")
  entityId  String?  @map("entidade_id")
  oldValue  Json?    @map("valor_antigo")
  newValue  Json?    @map("valor_novo")
  createdAt DateTime @default(now()) @map("criado_em")

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("logs_auditoria")
}
