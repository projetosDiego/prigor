# ============================================================================
#  Doces Prigor OS — configuração
#  Copie para .env (desenvolvimento) ou .env.prod (produção) e preencha.
#  NUNCA versione o arquivo preenchido.
# ============================================================================

# ─── Banco ──────────────────────────────────────────────────────────────────
# Desenvolvimento com o docker-compose local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prigor"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prigor"

# Porta que o container do banco ocupa NA SUA MAQUINA. Só mexa se a 5432 já
# estiver ocupada (outro Postgres instalado, outro projeto). Se trocar aqui,
# troque também nas duas URLs acima — as três têm que bater.
# DB_PORT=5433

# ─── Sessão ─────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com:  openssl rand -hex 32
JWT_SECRET=""
SESSION_TTL_HOURS=12

# ─── Aplicação ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
LOG_LEVEL="debug"
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# ─── Google Places ──────────────────────────────────────────────────────────
# Sem chave real a prospecção PARA, em vez de gravar lead fictício.
GOOGLE_MAPS_API_KEY=""
# Ligue apenas para testar sem gastar API. Recusado em produção.
# ALLOW_MOCK_PLACES=true

# ─── Administrador inicial (usado pelo seed) ────────────────────────────────
# Sem estes dois, o seed não cria usuário nenhum. Mínimo 12 caracteres.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ─── Dados da empresa (aparecem no PDF do pedido) ───────────────────────────
COMPANY_NAME="Doces Prigor"
COMPANY_LEGAL_NAME="64.189.960 Igor Cordeiro Lopes Moura da Silva"
COMPANY_CNPJ="64.189.960/0001-24"
COMPANY_ADDRESS="Campo de São Cristóvão - Imperial de São Cristóvão"
COMPANY_CITY="Rio de Janeiro"
COMPANY_STATE="RJ"
COMPANY_ZIP="20921-440"
COMPANY_PHONE="21979908138"
COMPANY_EMAIL="vendas@docesprigor.com.br"

# ─── Envio de E-mails (Hostinger SMTP) ──────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contato@docesprigor.com.br"
SMTP_PASS=""
SMTP_FROM="Doces Prigor <contato@docesprigor.com.br>"
NOTIFICATION_EMAIL="contato@docesprigor.com.br"

# ─── Somente produção (docker-compose.prod.yml) ─────────────────────────────
# POSTGRES_USER="prigor"
# POSTGRES_PASSWORD=""
# POSTGRES_DB="prigor"
# APP_URL="https://erp.seudominio.com.br"
# RUN_SEED=false

# ─── Faturamento: boleto (Sicoob) e nota fiscal ────────────────────────────
# Tudo opcional: sem isto o ERP funciona, só a emissão fica indisponível.
# Ver docs/INTEGRACAO-BOLETO-NF.md. Certificado: rode `npm run cert:setup`.
BILLING_ENABLED=false
SICOOB_ENV="sandbox"                 # sandbox | production
SICOOB_CLIENT_ID=""
SICOOB_SANDBOX_TOKEN=""              # menu "Sandbox" do portal Sicoob
SICOOB_CERT_PATH=""                  # preenchido pelo npm run cert:setup
SICOOB_CERT_PASSWORD=""              # preenchido pelo npm run cert:setup
SICOOB_NUMERO_CLIENTE=""             # convênio de cobrança (gerente)
SICOOB_CONTA_CORRENTE=""
SICOOB_MODALIDADE=1                  # confirmar com o gerente
FISCAL_PROVIDER=""                   # focus | nuvemfiscal | plugnotas
FISCAL_API_TOKEN=""
FISCAL_ENV="homologacao"             # homologacao | producao
FISCAL_WEBHOOK_SECRET=""
