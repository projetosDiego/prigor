# Copie para .env e preencha. O .env nunca deve ser versionado.

# Banco do painel (Prisma). Hoje aponta para o Supabase.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/banco"

# Segredo do JWT. O ERP (FastAPI) le este mesmo valor para validar o token
# que o Next assina. Se mudar aqui, nao precisa mudar em lugar nenhum.
JWT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave do Google Places. Sem ela a prospeccao para (nao gera dado ficticio).
GOOGLE_MAPS_API_KEY=""

# Ligue APENAS se quiser rodar a prospeccao com dados simulados de proposito.
# ALLOW_MOCK_PLACES=true

# URL do backend ERP usado pelo proxy /api/erp
ERP_BACKEND_URL="http://localhost:8000"
